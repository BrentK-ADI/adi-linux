/dts-v1/;
/plugin/;

/{
	compatible = "brcm,bcm2835";
};

&i2c_csi_dsi {
	status = "okay";
	max_des_0: gmsl-deserializer@2a {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "maxim,max96716a";
		reg = <0x2a>;
		/* GPIO_ACTIVE_LOW = 1 */
		powerdown-gpios = <&expgpio 5 1>;
	};
};

&cam1_reg {
	status = "disabled";
};

&max_des_0 {
	i2c-alias-pool = <0x40 0x41 0x42 0x43>;

	max_des_0_i2c_adapter: i2c-atr {
		#address-cells = <1>;
		#size-cells = <0>;
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&max_des_0 {
	ports {
		port@3 {
			reg = <3>;

			max_des_0_phy_1_out: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <750000000>;
			};
		};
	};
};

&csi1 {
	status = "okay";
	compatible = "brcm,bcm2835-unicam-upstream";

	port {
		csi1_ep: endpoint {
			remote-endpoint = <&max_des_0_phy_1_out>;
			clock-lanes = <0>;
			data-lanes = <1 2>;
			link-frequencies = /bits/ 64 <750000000>;
			clock-noncontinuous;
		};
	};
};

&max_des_0_phy_1_out {
	remote-endpoint = <&csi1_ep>;
};

&max_des_0_i2c_adapter {
	max_des_0_i2c_0: i2c@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x0>;
	};
};

&max_des_0_i2c_0 {
	max_des_0_ser_0: gmsl-serializer@40 {
		#address-cells = <1>;
		#size-cells = <0>;
		#gpio-cells = <2>;
		#clock-cells = <0>;

		compatible = "maxim,max96717";
		reg = <0x40>;

		gpio-controller;
		gpio-ranges = <&max_des_0_ser_0 0 0 11>;
	};
};

&max_des_0_ser_0 {
	i2c-alias-pool = <0x50 0x51>;

	i2c-atr {
		#address-cells = <1>;
		#size-cells = <0>;

		max_des_0_ser_0_i2c_0: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0>;
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			max_des_0_ser_0_out: endpoint {
				remote-endpoint = <&max_des_0_in_0>;
			};
		};
	};
};

&max_des_0 {
	ports {
		port@0 {
			reg = <0x0>;

			max_des_0_in_0: endpoint {
				remote-endpoint = <&max_des_0_ser_0_out>;
			};
		};
	};
};

&{/} {
	max_des_0_ser_0_cam_0_xclk: max_des_0_ser_0_cam_0_xclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};
};

&max_des_0_ser_0_i2c_0 {
	max_des_0_ser_0_cam_0: imx335@1a {
		compatible = "sony,imx335";
		reg = <0x1a>;
		clocks = <&max_des_0_ser_0_cam_0_xclk>;

		rotation = <0>;
		orientation = <2>;
		sony,hot-attach;
		sony,default-pixel-format = <10>;
		port {
			max_des_0_ser_0_cam_0_out: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <594000000>;
				remote-endpoint = <&max_des_0_ser_0_in_0>;
			};
		};
	};
};

&max_des_0_ser_0 {
	ports {
		port@0 {
			reg = <0>;

			max_des_0_ser_0_in_0: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				link-frequencies = /bits/ 64 <594000000>;
				remote-endpoint = <&max_des_0_ser_0_cam_0_out>;
			};
		};
	};
};

&i2c0if {
	status = "okay";
};

&i2c0mux {
	status = "okay";
};
